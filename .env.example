# --- Database (libSQL) -------------------------------------------------------
# Local dev: an embedded SQLite file (created automatically).
DATABASE_URL=file:./data/portfolio.db
# Production: a Turso database, e.g. libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# --- Dashboard owner account (used by `npm run db:seed` / `npm run admin:set`) --
# No sign-up exists; this CLI is the only way to create the login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=Change-Me-Strong-Passw0rd
ADMIN_NAME=Owner

# --- Contact form (EmailJS, exposed to the browser) ---------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
